name: Auto Update Files

on:
  push:
    branches:
      - main
  schedule:
    - cron: '*/5 * * * *'

jobs:
  update-files:
    runs-on: ubuntu-latest
    permissions:
      contents: write # Allows the workflow to write changes back to your repo

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Run Your Update Script
        run: |
          # Replace this line with your actual generation command 
          # Example: python update_readme.py or npm run build
          echo "Automated content" >> log.txt 

      - name: Commit and Push Changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git diff-index --quiet HEAD || git commit -m "Automated file update"
          git push
